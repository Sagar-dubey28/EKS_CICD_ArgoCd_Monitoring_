{
  "title": "EKS DevOps Monitoring",
  "uid": "eks-devops-monitoring",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pod Count",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(kube_pod_info{namespace=\"devops-demo\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ready Pods",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"devops-demo\",condition=\"true\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU by Pod",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"devops-demo\",container=\"app\",image!=\"\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory by Pod",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"devops-demo\",container=\"app\",image!=\"\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pod Restarts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"devops-demo\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A"
        }
      ]
    }
  ]
}